{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.taxtech/schemas/rulepack.schema.json",
  "title": "Meridian Rule-Pack (rp-*) — SPEC §1.4 grammar",
  "type": "object",
  "required": ["id", "version", "effective_from", "status", "subject_to_regazette", "provenance", "rules"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rp-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Pack identifier, e.g. rp-wht-2024"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer, e.g. 1.0.0"
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "effective_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "effective_to": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "simulation", "published", "retired"]
    },
    "subject_to_regazette": {
      "type": "boolean",
      "description": "G1 flag — true until CTCs (certified true copies) confirmed"
    },
    "provenance": {
      "type": "object",
      "required": ["as_passed", "as_gazetted", "source_citation"],
      "additionalProperties": false,
      "properties": {
        "as_passed": { "type": "string" },
        "as_gazetted": { "type": ["string", "null"] },
        "source_citation": { "type": "string" }
      }
    },
    "signed": {
      "type": "object",
      "required": ["algorithm", "key_id", "signature"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "enum": ["ed25519"] },
        "key_id": { "type": "string" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    },
    "boundary_semantics": {
      "type": "string",
      "description": "Optional band/threshold boundary convention (e.g. min_inclusive_max_exclusive) — I13 metadata for packs defining adjacent bands"
    },
    "parameters": {
      "type": "object",
      "description": "Named scalar parameters referenced by formulas/tables (money in integer kobo unless suffixed otherwise)",
      "additionalProperties": true
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "when", "then"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"
        },
        "description": { "type": "string" },
        "effective_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "effective_to": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "when": {
          "type": "object",
          "description": "Condition map: fact name -> expected value / operator map",
          "additionalProperties": true
        },
        "then": {
          "type": "object",
          "description": "Decision payload. Kinds: rate_bps, threshold, band table, formula (expression string), decision table.",
          "additionalProperties": true,
          "properties": {
            "narrate": { "type": "string" },
            "rate_bps": { "type": "integer" },
            "threshold": { "type": "object" },
            "table": { "type": "array" },
            "formula": { "type": "string" },
            "decision": { "type": ["string", "boolean", "number"] }
          }
        },
        "citation": { "type": "string" }
      }
    }
  }
}
